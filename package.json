{
  "name": "glow-face",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,vite\" -c \"green,cyan\" \"npm run server:dev\" \"vite\"",
    "dev:vite": "vite",
    "server:dev": "npm --prefix server run dev",
    "server:install": "npm --prefix server ci --include=dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server start",
    "create-admin": "npm --prefix server run create-admin",
    "build": "npm run server:install && npm run server:build && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.3",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}