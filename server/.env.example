# ==============================================================================
# GLOW FACE BACKEND ENVIRONMENT CONFIGURATION (server/.env)
# ==============================================================================
# Instructions:
# 1. Copy this template to server/.env:
#    cp server/.env.example server/.env
# 2. Fill in the credentials below.
#
# NEVER commit server/.env to version control.
# ==============================================================================

PORT=3001
NODE_ENV=production
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glowface_db?schema=public

JWT_SECRET=super_secret_jwt_random_key_min_32_characters_here_abc123!
JWT_EXPIRES_IN=7d

RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=care@glowface.in
SMTP_PASS=your_app_specific_password_or_smtp_key
EMAIL_FROM="Glow Face Skincare <glowface.kl@gmail.com>"
ADMIN_NOTIFICATION_EMAIL=glowface.kl@gmail.com

WHATSAPP_PHONE_NUMBER_ID=YOUR_META_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_META_PERMANENT_SYSTEM_USER_ACCESS_TOKEN
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_META_BUSINESS_ACCOUNT_ID

INSTAGRAM_ACCOUNT_ID=YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID
META_ACCESS_TOKEN=YOUR_META_INSTAGRAM_GRAPH_API_TOKEN
INSTAGRAM_HANDLE=glowface.kl