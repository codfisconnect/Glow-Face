# ==============================================================================
# GLOW FACE CLIENT ENVIRONMENT VARIABLES (Vite Frontend)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in the root directory:
#    cp .env.example .env
# 2. Supply your public keys below.
#
# IMPORTANT SECURITY NOTICE:
# ONLY variables prefixed with VITE_ are bundled into client JavaScript.
# NEVER put private backend credentials (Razorpay Secret, JWT Secret, DB Password) here.
# ==============================================================================

# Backend API Base URL (leave empty in development to use Vite proxy to http://localhost:3001)
VITE_API_URL=

# Razorpay Publishable Key ID (Client-safe)
# Example: rzp_test_ABC123456789 or rzp_live_XYZ987654321
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder

# Store Support Phone / WhatsApp Display
VITE_STORE_WHATSAPP=+91 87785 48891
VITE_STORE_EMAIL=glowface.kl@gmail.com
